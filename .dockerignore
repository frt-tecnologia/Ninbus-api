# ── Dependencies ────────────────────────────────────────────
node_modules

# ── Development ─────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Build artifacts (rebuilt in Docker) ────────────────────
dist
*.log
*.tsbuildinfo

# ── Git ────────────────────────────────────────────────────
.git
.gitignore

# ── IDE ────────────────────────────────────────────────────
.vscode
.idea
*.swp
*.swo

# ── Documentation ──────────────────────────────────────────
README.md
plan

# ── CI/CD ──────────────────────────────────────────────────
.github

# ── Tests (not needed in production image) ─────────────────
tests
*.test.ts
*.spec.ts
__tests__
coverage

# ── Harness / tooling configs (dev tooling) ───────────────
.harness
drizzle.gen.config.ts
drizzle.bak
drizzle-tmp*

# ── OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
# Windows reserved device-name paths break the build context sender
nul
nul/**
certbot
apps

# ── Docker (prevent recursion) ─────────────────────────────
docker-compose*.yml
Dockerfile
.dockerignore
