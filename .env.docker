# ═══════════════════════════════════════════════════════════════
# Ninbus API — Docker Environment (Production)
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────
NODE_ENV=production
HOST=0.0.0.0
PORT=8081

# ── Database (Neon cloud) ────────────────────────────────────
# Swap to local PG: postgresql://postgres:postgres@hawkbit-db:5432/ninbus_db
DATABASE_URL=postgresql://neondb_owner:npg_tWCXuyq9VH1o@ep-dry-voice-acl3s09t-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Authentication ───────────────────────────────────────────
ENABLE_AUTH=true
REQUIRE_EMAIL_VERIFICATION=false
BETTER_AUTH_SECRET=change-this-to-a-64-char-random-string-use-openssl-rand-base64-48
BETTER_AUTH_URL=https://api.ninbus.com

# ── Email ────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@ninbus.com

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=https://ninbus.com,https://app.ninbus.com

# ── hawkBit Database (Neon PostgreSQL) ────────────────────────
# JDBC format (hawkBit uses JDBC, not node-postgres)
HAWKBIT_DATABASE_URL=jdbc:postgresql://ep-dry-voice-acl3s09t-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
HAWKBIT_DB_USER=neondb_owner
HAWKBIT_DB_PASS=npg_tWCXuyq9VH1o
HAWKBIT_ADMIN_PASSWORD={noop}admin

# ── hawkBit Connection ──────────────────────────────────────
HAWKBIT_ENABLED=true
HAWKBIT_URL=http://hawkbit:8080
HAWKBIT_USERNAME=admin
HAWKBIT_PASSWORD=admin
HAWKBIT_TIMEOUT_MS=30000
HAWKBIT_SKIP_TLS=false
HAWKBIT_PORT=8080

# ── hawkBit Resources ───────────────────────────────────────
HAWKBIT_XMS=512m
HAWKBIT_XMX=768m
HAWKBIT_MEM_LIMIT=1g
HAWKBIT_CPUS=1.0

# ── S3 Endpoint — CURRENT: MinIO (local S3-compatible)
# FUTURE swap to Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_ACCESS_KEY=<r2-access-key-id>
#   S3_SECRET_KEY=<r2-secret-access-key>
#   S3_BUCKET=ninbus-artifacts
#   S3_REGION=auto
S3_ENDPOINT=http://s3:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=secret123
S3_BUCKET=ninbus-artifacts
S3_REGION=
S3_PORT=8333
S3_CONSOLE_PORT=9001

# ── API Resources ───────────────────────────────────────────
API_MEM_LIMIT=256m
API_CPUS=0.5

# ── SeaweedFS Resources ────────────────────────────────────
S3_MEM_LIMIT=256m
S3_CPUS=0.25

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
ENABLE_RATE_LIMITER=true


# ── hawkBit Background Sync ─────────────────────────────────
HAWKBIT_SYNC_INTERVAL_SEC=30
HAWKBIT_SYNC_STALE_SEC=60
