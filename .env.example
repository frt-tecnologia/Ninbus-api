# ═══════════════════════════════════════════════════════════════
# Ninbus API — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# All variables are validated at startup via TypeBox (src/common/config/env.ts).
# Missing required variables will prevent the server from starting.
# ═══════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=8081

# ── Database (required) ────────────────────────────────────────
# PostgreSQL connection string. Neon cloud recommended.
DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require

# ── Authentication ─────────────────────────────────────────────
ENABLE_AUTH=true
REQUIRE_EMAIL_VERIFICATION=false
BETTER_AUTH_SECRET=change-me-to-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:8081
# Platform super admins (comma-separated). These users bypass all company membership checks.
SUPER_ADMIN_EMAILS=admin@ninbus.io

# ── Email (optional — required for password reset) ─────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@ninbus.io

# ── hawkBit Integration ────────────────────────────────────────
# Set HAWKBIT_ENABLED=true to activate OTA features.
# When false, all hawkBit routes return 503 and background sync is disabled.
HAWKBIT_ENABLED=false
HAWKBIT_URL=http://localhost:8080
HAWKBIT_USERNAME=admin
HAWKBIT_PASSWORD=admin
HAWKBIT_TIMEOUT_MS=30000
HAWKBIT_SKIP_TLS=false

# ── hawkBit Sync Engine ────────────────────────────────────────
# Mode: periodic | on_demand | hybrid
#   periodic  → sync ALL targets every N seconds (<1k devices)
#   on_demand → zero background, per-request with stale-while-revalidate cache
#   hybrid    → background sync only for companies with active sessions (recommended, 50k+ devices)
HAWKBIT_SYNC_MODE=hybrid
# HAWKBIT_SYNC_INTERVAL_SEC=10        # Background sync interval (periodic/hybrid)
# HAWKBIT_SYNC_STALE_SEC=60           # Stale threshold for single-device on-demand sync
# HAWKBIT_SYNC_ACTIVE_WINDOW_SEC=300  # Seconds to consider a company "active"

# ── hawkBit Provisioning ──────────────────────────────────────
# When true, unknown devices auto-create targets on first DDI poll.
# SET TO FALSE IN PRODUCTION — only pre-registered devices should connect.
HAWKBIT_AUTOPROVISIONING=false

# ── SSE (Server-Sent Events) ──────────────────────────────────
# Real-time push to Flutter. Disabled endpoints return 503.
SSE_ENABLED=true
SSE_HEARTBEAT_SEC=30
SSE_MAX_CONNECTIONS_PER_COMPANY=50

# ── hawkBit Docker (used by docker-compose.yml) ────────────────
# These are passed to the hawkBit container, NOT to the Ninbus API.
HAWKBIT_DATABASE_URL=jdbc:postgresql://host:5432/hawkbit_db?sslmode=require
HAWKBIT_DB_USER=admin
HAWKBIT_DB_PASS=secret
HAWKBIT_ADMIN_PASSWORD={noop}admin
HAWKBIT_DDI_TARGET_TOKEN_AUTH=true

# ── S3 Artifact Storage (used by docker-compose.yml) ──────────
# Set HAWKBIT_S3_ENABLED=true to store artifact binaries in S3/MinIO.
# When false, hawkBit stores artifacts on local filesystem (Docker volume).
HAWKBIT_S3_ENABLED=false
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=admin
S3_SECRET_KEY=secret123
S3_BUCKET=ninbus-artifacts
S3_REGION=
S3_PORT=8333
S3_CONSOLE_PORT=9001

# ── General ────────────────────────────────────────────────────
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
ENABLE_RATE_LIMITER=true
