# ═══════════════════════════════════════════════════════════════
# Ninbus API — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# All variables are validated at startup via TypeBox (src/common/config/env.ts).
# Missing required variables will prevent the server from starting.
# ═══════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=8081

# ── Database (required) ────────────────────────────────────────
# PostgreSQL connection string. Neon cloud recommended.
DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require

# ── Authentication ─────────────────────────────────────────────
ENABLE_AUTH=true
REQUIRE_EMAIL_VERIFICATION=false
BETTER_AUTH_SECRET=change-me-to-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:8081
# Session cookies with __Secure- prefix + Secure flag. Enable ONLY when the
# dashboard is served over HTTPS end-to-end (TLS live). Over HTTP, Secure
# cookies are dropped by the browser and login silently fails (POST returns
# 200 + set-cookie but the cookie is never stored). Default false.
AUTH_COOKIE_SECURE=false
# Platform super admins (comma-separated). These users bypass all company membership checks.
SUPER_ADMIN_EMAILS=admin@ninbus.com.br,superadmin@ninbus.com.br

# ── Email (optional — required for password reset) ─────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@ninbus.io
# Frontend base URL (for email links: password reset, verification)
# Defaults to BETTER_AUTH_URL if unset — set this to your frontend (e.g. http://localhost:5173)
FRONTEND_URL=http://localhost:5173
# Base for app deep links in emails (takes precedence over FRONTEND_URL).
# MUST be an https App Link so links are clickable inside mobile email apps
# (Gmail/Outlook/Yahoo strip non-http(s) hrefs as anti-phishing). A custom
# scheme like ninbus:// is NOT clickable in most mobile email clients.
# Requires /.well-known/{assetlinks.json,apple-app-site-association} served by
# nginx at this host, plus App Link/Universal Link config in the Flutter app.
APP_DEEP_LINK_BASE=https://ninbus.frt.com.br
# Resend Dashboard template aliases (or tmpl_ IDs). Templates must be PUBLISHED
# in the Resend dashboard. If unset, the API falls back to inline HTML.
# password-reset template variables: first_name, reset_password_url
RESEND_TEMPLATE_PASSWORD_RESET=password-reset
# verify-email template variables: first_name, verify_email_url
RESEND_TEMPLATE_EMAIL_VERIFICATION=email-verification

# ── hawkBit Integration ────────────────────────────────────────
# Set HAWKBIT_ENABLED=true to activate OTA features.
# When false, all hawkBit routes return 503 and background sync is disabled.
HAWKBIT_ENABLED=false
HAWKBIT_URL=http://localhost:8080
HAWKBIT_USERNAME=admin
HAWKBIT_PASSWORD=admin
HAWKBIT_TIMEOUT_MS=30000
HAWKBIT_SKIP_TLS=false

# ── hawkBit Sync Engine ────────────────────────────────────────
# Mode: periodic | on_demand | hybrid
#   periodic  → sync ALL targets every N seconds (<1k devices)
#   on_demand → zero background, per-request with stale-while-revalidate cache
#   hybrid    → background sync only for companies with active sessions (recommended, 50k+ devices)
HAWKBIT_SYNC_MODE=hybrid
# HAWKBIT_SYNC_INTERVAL_SEC=30        # Background sync interval (periodic/hybrid)
# HAWKBIT_SYNC_STALE_SEC=60           # Stale threshold for single-device on-demand sync
# HAWKBIT_SYNC_ACTIVE_WINDOW_SEC=300  # Seconds to consider a company "active"

# ── Artifacts (upload limit) ─────────────────────────────────
# Max firmware upload size in MB. Defends against memory DoS (tar packager buffers in RAM).
ARTIFACT_MAX_SIZE_MB=50

# ── hawkBit Provisioning ──────────────────────────────────────
# When true, unknown devices auto-create targets on first DDI poll.
# SET TO FALSE IN PRODUCTION — only pre-registered devices should connect.
HAWKBIT_AUTOPROVISIONING=false

# ── SSE (Server-Sent Events) ──────────────────────────────────
# Real-time push to Flutter. Disabled endpoints return 503.
SSE_ENABLED=true
SSE_HEARTBEAT_SEC=30
SSE_MAX_CONNECTIONS_PER_COMPANY=50

# ── Observability (audit + telemetry retention) ─────────────
# Device connection telemetry retention in days. Older rows are
# batch-deleted hourly. 0 disables retention (keep forever).
# activity_log (audit) is NEVER expired.
OBS_CONNECTIONS_RETENTION_DAYS=90

# ── hawkBit Docker (used by docker-compose.yml) ────────────────
# These are passed to the hawkBit container, NOT to the Ninbus API.
HAWKBIT_DATABASE_URL=jdbc:postgresql://host:5432/hawkbit_db?sslmode=require
HAWKBIT_DB_USER=admin
HAWKBIT_DB_PASS=secret
HAWKBIT_ADMIN_PASSWORD={noop}admin
HAWKBIT_DDI_TARGET_TOKEN_AUTH=true

# ── S3 Artifact Storage (AWS S3 / Cloudflare R2) ──────────────
# hawkBit stores artifact binaries in S3/R2 (private bucket).
# Devices download via CDN (CloudFront or R2 custom domain).
#
# AWS S3 example:
#   S3_ENDPOINT=              (empty = AWS regional default)
#   S3_REGION=sa-east-1
#   S3_ACCESS_KEY=AKIA...
#   S3_SECRET_KEY=...
#
# Cloudflare R2 example:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_ACCESS_KEY=<r2-access-key-id>
#   S3_SECRET_KEY=<r2-secret-access-key>
HAWKBIT_S3_ENABLED=false
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ninbus-artifacts

# ── CDN Download (CloudFront or R2) ────────────────────────────
# When set, hawkBit DDI returns CDN URLs in deploymentBase for device download.
# The STM32 follows these URLs — no firmware change needed.
#
# Mode A (AWS CloudFront RSA) — requires CloudFront Distribution + Key Pair:
#   HAWKBIT_CDN_BASE_URL=http://dxxxxxxxxxx.cloudfront.net
#   HAWKBIT_CDN_KEY_PAIR_ID=K123456789EXAMPLE
#   HAWKBIT_CDN_PRIVATE_KEY_PATH=/run/secrets/cf-private-key.pem
#
# Mode B (Cloudflare R2 HMAC) — zero extra infra, just R2 custom domain:
#   HAWKBIT_CDN_BASE_URL=http://r2.seudominio.com
#   (leave HAWKBIT_CDN_KEY_PAIR_ID empty = automatic R2 mode)
#
# No CDN (default): leave HAWKBIT_CDN_BASE_URL empty → hawkBit serves artifacts.
HAWKBIT_CDN_BASE_URL=
HAWKBIT_CDN_KEY_PAIR_ID=
HAWKBIT_CDN_PRIVATE_KEY_PATH=
HAWKBIT_CDN_EXPIRY_SEC=3600

# ── General ────────────────────────────────────────────────────
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:3001
ENABLE_RATE_LIMITER=true

# ── Docker Resource Limits ──────────────────────────────────────
# API container
# API_MEM_LIMIT=256m
# API_CPUS=0.5
# hawkBit container
# HAWKBIT_PORT=8080
# HAWKBIT_MEM_LIMIT=1g
# HAWKBIT_CPUS=1.0
# HAWKBIT_XMS=512m
# HAWKBIT_XMX=768m
