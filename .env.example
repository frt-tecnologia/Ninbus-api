# ═══════════════════════════════════════════════════════════════
# Ninbus API — Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=8081

# ── Database (PostgreSQL) ───────────────────────────────────
# Neon cloud example:  postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require
# Local example:       postgresql://postgres:postgres@localhost:5432/ninbus_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ninbus_db

# ── Authentication (Better Auth) ───────────────────────────
ENABLE_AUTH=true
REQUIRE_EMAIL_VERIFICATION=false
BETTER_AUTH_SECRET=your-very-long-random-secret-here-min-32-chars
BETTER_AUTH_URL=http://localhost:8081

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# ── Eclipse hawkBit Update Server ──────────────────────────
HAWKBIT_ENABLED=true
HAWKBIT_URL=http://localhost:8080
HAWKBIT_USERNAME=admin
HAWKBIT_PASSWORD=admin
HAWKBIT_TIMEOUT_MS=30000
HAWKBIT_SKIP_TLS=false

# ── Rate Limiting ──────────────────────────────────────────
ENABLE_RATE_LIMITER=true
