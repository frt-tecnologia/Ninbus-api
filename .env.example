# ── Ninbus API ──────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=8081

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ninbus_db

# ── Auth ───────────────────────────────────────────────────────
ENABLE_AUTH=true
REQUIRE_EMAIL_VERIFICATION=false
BETTER_AUTH_SECRET=<min-32-chars>
BETTER_AUTH_URL=http://localhost:8081
SUPER_ADMIN_EMAILS=admin@example.com

# ── Email ──────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# ── hawkBit API ────────────────────────────────────────────────
HAWKBIT_ENABLED=false
HAWKBIT_URL=http://localhost:8080
HAWKBIT_USERNAME=admin
HAWKBIT_PASSWORD=admin
HAWKBIT_TIMEOUT_MS=30000
HAWKBIT_SKIP_TLS=false
HAWKBIT_AUTOPROVISIONING=false

# ── hawkBit Docker (docker-compose.yml) ────────────────────────
HAWKBIT_DATABASE_URL=jdbc:postgresql://localhost:5432/ninbus_db
HAWKBIT_DB_USER=postgres
HAWKBIT_DB_PASS=postgres
HAWKBIT_ADMIN_PASSWORD={noop}admin
HAWKBIT_DDI_TARGET_TOKEN_AUTH=true

# ── S3 Artifact Storage (docker-compose.yml) ──────────────────
HAWKBIT_S3_ENABLED=false
# ── hawkBit Sync Mode ─────────────────────────────────────────
# periodic: sync ALL targets every N seconds (good for <1k devices)
# on_demand: zero background, each API request queries hawkBit with cache
# hybrid: background sync only for companies with active sessions (recommended, scales to 50k+)
HAWKBIT_SYNC_MODE=hybrid
# HAWKBIT_SYNC_INTERVAL_SEC=30
# HAWKBIT_SYNC_STALE_SEC=60
# HAWKBIT_SYNC_ACTIVE_WINDOW_SEC=300
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=admin
S3_SECRET_KEY=secret123
S3_BUCKET=ninbus-artifacts
S3_PORT=8333
S3_CONSOLE_PORT=9001

# ── Misc ───────────────────────────────────────────────────────
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
ENABLE_RATE_LIMITER=true

# ── SSE (Server-Sent Events) ──────────────────────────────
SSE_ENABLED=true
SSE_HEARTBEAT_SEC=30
SSE_MAX_CONNECTIONS_PER_COMPANY=50
