# ═══════════════════════════════════════════════════════════════
# Ninbus API — Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=8081

# ── Database (PostgreSQL) ───────────────────────────────────
# Neon cloud example:  postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require
# Local example:       postgresql://postgres:postgres@localhost:5432/ninbus_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ninbus_db

# ── Authentication (Better Auth) ───────────────────────────
ENABLE_AUTH=true
REQUIRE_EMAIL_VERIFICATION=false
BETTER_AUTH_SECRET=your-very-long-random-secret-here-min-32-chars
BETTER_AUTH_URL=http://localhost:8081

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# ── Eclipse hawkBit Update Server ──────────────────────────
HAWKBIT_ENABLED=true
HAWKBIT_URL=http://localhost:8080
HAWKBIT_USERNAME=admin
HAWKBIT_PASSWORD=admin
HAWKBIT_TIMEOUT_MS=30000
HAWKBIT_SKIP_TLS=false

# ── hawkBit Database (JDBC — for docker compose) ────────────
# hawkBit uses JDBC (not node-postgres). Format:
#   jdbc:postgresql://host:port/database?sslmode=require
HAWKBIT_DATABASE_URL=jdbc:postgresql://localhost:5432/ninbus_db
HAWKBIT_DB_USER=postgres
HAWKBIT_DB_PASS=postgres
HAWKBIT_ADMIN_PASSWORD={noop}admin

# ── hawkBit DDI Auto-Provisioning ──────────────────────────
# When true, hawkBit auto-creates targets on first DDI poll.
# The device must send the correct securityToken via Authorization header.
HAWKBIT_AUTOPROVISIONING=true

# ── hawkBit DDI TargetToken Auth ───────────────────────────
# REQUIRED for device polling! When false, ALL DDI requests return 401.
# Devices send: Authorization: TargetToken <securityToken>
HAWKBIT_DDI_TARGET_TOKEN_AUTH=true

# ── hawkBit S3 Artifact Storage ─────────────────────────────
# Set HAWKBIT_S3_ENABLED=true to store binaries in S3
# Swap to Cloudflare R2 by changing S3_ENDPOINT + credentials
HAWKBIT_S3_ENABLED=false
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=admin
S3_SECRET_KEY=secret123
S3_BUCKET=ninbus-artifacts
S3_REGION=
S3_PORT=8333
S3_CONSOLE_PORT=9001

# ── Rate Limiting ──────────────────────────────────────────
ENABLE_RATE_LIMITER=true
