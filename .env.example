# ═══════════════════════════════════════════════════════════════
# Ninbus API — Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# ── Database (PostgreSQL) ───────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elysia_db

# ── Authentication (Better Auth) ────────────────────────────────
ENABLE_AUTH=true
REQUIRE_EMAIL_VERIFICATION=false
# ⚠️ SECURITY: Generate a strong secret (min 32 chars)
# Example: openssl rand -base64 32
BETTER_AUTH_SECRET=your-very-long-random-secret-here
# Base URL of your app (used for redirects and email links)
BETTER_AUTH_URL=http://localhost:3000

# ── Logging ─────────────────────────────────────────────────────
# Levels: fatal/error/warn/info/debug/trace
LOG_LEVEL=info

# ── CORS ────────────────────────────────────────────────────────
# Comma-separated origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Email (Resend) ──────────────────────────────────────────────
# Optional — logs to console if not set
# RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=noreply@example.com

# ── Eclipse hawkBit Update Server Integration ───────────────────
# ⚠️ REQUIRED for device management and OTA deployments
# @see https://www.eclipse.org/hawkbit/
HAWKBIT_ENABLED=true
HAWKBIT_URL=http://localhost:8080
# hawkBit uses HTTP Basic Auth for the Management API
# Default admin credentials: admin / admin
HAWKBIT_USERNAME=admin
HAWKBIT_PASSWORD=admin
HAWKBIT_TIMEOUT_MS=30000
# Skip TLS verification (self-signed certs in dev)
HAWKBIT_SKIP_TLS=false

# ── Rate Limiting ───────────────────────────────────────────────
ENABLE_RATE_LIMITER=true
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# AUTH_RATE_LIMIT_MAX=10
