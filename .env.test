# ─────────────────────────────────────────────────────────────────
# Test Environment Configuration
# Used by: bun test --env-file=.env.test
# ─────────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────────
NODE_ENV=test
HOST=localhost
PORT=3000

# ── Database (PostgreSQL via Drizzle) ───────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ninbus_db

# ── Authentication (Better Auth) ────────────────────────────────
ENABLE_AUTH=true
REQUIRE_EMAIL_VERIFICATION=false
BETTER_AUTH_SECRET=LdqfTGVQsDmuHCaqW6jQMX7IWgC5CfnTaKi0/pzSu8s=
BETTER_AUTH_URL=http://localhost:3000

# ── Email — disabled for tests ──────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@test.com

# ── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=error

# ── CORS ────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Rate Limiting — disabled for tests ──────────────────────────
ENABLE_RATE_LIMITER=false

# ── hawkBit — disabled for tests (mocked) ───────────────────────
HAWKBIT_ENABLED=false
HAWKBIT_URL=http://localhost:8080
HAWKBIT_USERNAME=admin
HAWKBIT_PASSWORD=admin
HAWKBIT_TIMEOUT_MS=5000
HAWKBIT_SKIP_TLS=true
