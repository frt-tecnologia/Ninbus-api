# ─────────────────────────────────────────────────────────────────
# Test Environment Configuration
# Used by: bun test --env-file=.env.test
# ─────────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────────
NODE_ENV=test
HOST=localhost
PORT=3000

# ── Database (PostgreSQL via Drizzle) — Neon cloud for CI/test ──
DATABASE_URL=postgresql://neondb_owner:npg_RyTQ9In4LPgc@ep-royal-butterfly-ac5xifwc-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Authentication (Better Auth) ────────────────────────────────
ENABLE_AUTH=true
REQUIRE_EMAIL_VERIFICATION=false
BETTER_AUTH_SECRET=LdqfTGVQsDmuHCaqW6jQMX7IWgC5CfnTaKi0/pzSu8s=
BETTER_AUTH_URL=http://localhost:3000

# ── Platform Super Admin ────────────────────────────────────────
# Test admin email — used by super admin tests
SUPER_ADMIN_EMAILS=admin-test@ninbus.com.br

# ── Email — disabled for tests ──────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@test.com

# ── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=error

# ── CORS ────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Rate Limiting — disabled for tests ──────────────────────────
ENABLE_RATE_LIMITER=false

# ── hawkBit — disabled for tests (mocked) ───────────────────────
HAWKBIT_ENABLED=false
HAWKBIT_URL=http://localhost:8080
HAWKBIT_USERNAME=admin
HAWKBIT_PASSWORD=admin
HAWKBIT_TIMEOUT_MS=5000
HAWKBIT_SKIP_TLS=true

HAWKBIT_AUTOPROVISIONING=false
HAWKBIT_SYNC_INTERVAL_SEC=30
HAWKBIT_SYNC_STALE_SEC=60
HAWKBIT_SYNC_MODE=on_demand
HAWKBIT_SYNC_ACTIVE_WINDOW_SEC=300

# ── S3/CDN — disabled for tests ───────────────────────────
HAWKBIT_CDN_BASE_URL=
HAWKBIT_CDN_KEY_PAIR_ID=

# ── SSE (disabled in test environment) ────────────────────
SSE_ENABLED=true
SSE_HEARTBEAT_SEC=30
SSE_MAX_CONNECTIONS_PER_COMPANY=50

# ── Rate Limiting — disabled for tests ──────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
