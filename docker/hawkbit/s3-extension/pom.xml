<?xml version="1.0" encoding="UTF-8"?>
<!--
  Standalone build of hawkBit S3 artifact storage extension.
  Compiled against hawkBit 1.0.3 APIs (ArtifactStorage, AbstractArtifactStorage).
  Does NOT depend on hawkbit-extensions parent POM.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.eclipse.hawkbit</groupId>
  <artifactId>hawkbit-extension-artifact-repository-s3</artifactId>
  <version>1.0.3-S3</version>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.13</version>
  </parent>

  <properties>
    <java.version>21</java.version>
    <aws.sdk.version>1.12.782</aws.sdk.version>
  </properties>

  <dependencies>
    <!-- hawkBit 1.0.3 artifact API (provided by base image) -->
    <dependency>
      <groupId>org.eclipse.hawkbit</groupId>
      <artifactId>hawkbit-artifact-api</artifactId>
      <version>1.0.3</version>
      <scope>provided</scope>
    </dependency>

    <!-- AWS SDK v1 for S3 -->
    <dependency>
      <groupId>com.amazonaws</groupId>
      <artifactId>aws-java-sdk-s3</artifactId>
      <version>${aws.sdk.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <source>21</source>
          <target>21</target>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
