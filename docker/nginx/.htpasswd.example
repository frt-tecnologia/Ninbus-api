# nginx Basic Auth for /docs — HOW TO GENERATE
#
# This directory's .htpasswd (NOT this file) is bind-mounted into the nginx
# container at /etc/nginx/.htpasswd and gates access to /docs and /docs/json.
#
# .htpasswd is gitignored — generate it on the host with a strong password.
# The nginx:alpine image supports BCrypt ($2y$) hashes.
#
# Generate / rotate the credential (from the repo root, with Docker running):
#
#   docker run --rm httpd:alpine htpasswd -nbB ninbus-docs '<YOUR_STRONG_PASSWORD>' \
#     > docker/nginx/.htpasswd
#
# Then restart nginx:
#
#   docker compose restart nginx
#
# To add more users (append, keep existing):
#
#   docker run --rm -i httpd:alpine htpasswd -B ninbus-docs2 >> docker/nginx/.htpasswd \
#     <<< '<PASSWORD>'   # or omit password and type when prompted
#
# Multiple users = one per line. The realm name is "Ninbus API Docs"
# (set via auth_basic in docker/nginx/conf.d/ninbus.conf).
